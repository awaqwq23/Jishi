{
  "name": "@jishi/windows",
  "version": "0.4.3",
  "description": "记时多用户待办 Windows 客户端",
  "author": "Jishi",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "dev": "electron .",
    "build": "electron-builder --win nsis --publish never",
    "test": "node --test host-resolver.test.cjs"
  },
  "devDependencies": {
    "electron": "43.4.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "cn.jishi.todo",
    "productName": "记时",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "host-resolver.cjs",
      "app-config.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Jishi-Windows-Setup-${version}.${ext}"
    }
  }
}
