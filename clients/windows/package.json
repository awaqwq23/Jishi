{
  "name": "@jishi/windows",
  "version": "0.4.10",
  "description": "拾光记事多用户待办 Windows 客户端",
  "author": "Jishi",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "dev": "electron .",
    "build": "electron-builder --win nsis --publish never",
    "test": "node --test host-resolver.test.cjs update-downloader.test.cjs reminder-store.test.cjs system-notifier.test.cjs",
    "prebuild": "node ../../scripts/prepare-offline-shell.mjs windows"
  },
  "devDependencies": {
    "electron": "43.7.9",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "cn.jishi.todo",
    "productName": "拾光记事",
    "directories": {
      "output": "../../.local/build/windows"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "host-resolver.cjs",
      "update-downloader.cjs",
      "app-config.json",
      "reminder-store.cjs",
      "system-notifier.cjs",
      "offline-shell.cjs",
      "offline-shell/**"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Jishi-Windows-Setup-${version}.${ext}"
    }
  }
}
