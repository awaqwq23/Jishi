# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
**/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
**/.next/
**/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.selfhost.example

# vercel
.vercel

/dist/
**/dist/
**/dist-*/
/.wrangler/
**/.wrangler/
/.wrangler-legacy/
/outputs/
/work/
/.toolchains/
**/.data/
**/.gradle/
**/.cxx/
*.jks
*.keystore
.dev.vars
.dev.vars.*

# Local server access details; never commit or package these files.
/服务器设置.md
/服务器设置.*
*.p12
*.pfx
*.key
**/oh_modules/
**/.hvigor/
/clients/harmony/local.properties
/clients/harmony/entry/build/
/clients/harmony/build/
