[Unit]
Description=Jishi Web service
After=network-online.target jishi-api.service
Wants=network-online.target

[Service]
Type=simple
User=awaqwq233
Group=awaqwq233
WorkingDirectory=/opt/jishi/clients/web
Environment=NODE_ENV=production
Environment=NODE_OPTIONS=--max-old-space-size=192
ExecStart=/opt/jishi/node_modules/.bin/vinext start --hostname 127.0.0.1 --port 3000
ExecStartPost=/opt/jishi/server/deploy/native/mark-deployment.sh
Restart=on-failure
RestartSec=4
MemoryMax=300M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/jishi/clients/web/.wrangler /var/www/jishi-downloads

[Install]
WantedBy=multi-user.target
