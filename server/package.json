{
  "name": "@jishi/server",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --port 8787 --persist-to .data",
    "check": "tsc --noEmit && wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --persist-to .data",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260812.1",
    "typescript": "^5.9.3",
    "wrangler": "4.122.0"
  }
}
