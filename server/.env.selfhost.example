# 至少 32 个随机字符。Linux 可用 openssl rand -hex 32 生成。
AUTH_SECRET=
ALLOWED_ORIGINS=http://localhost:3000
# Set true only when a trusted reverse proxy overwrites X-Real-IP and the API
# is bound to loopback. Never trust client-supplied forwarded headers directly.
TRUST_PROXY_HEADERS=false
# Optional, isolated authentication gateway only. Empty disables identity headers.
AUTH_PROXY_SECRET=
