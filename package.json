{
  "name": "jishi-multi-platform",
  "version": "0.2.0",
  "private": true,
  "workspaces": [
    "server",
    "clients/web",
    "clients/windows",
    "clients/android"
  ],
  "scripts": {
    "install:all": "npm install --workspaces",
    "dev:web": "npm run dev --workspace @jishi/web",
    "dev:server": "npm run dev --workspace @jishi/server",
    "build:web": "npm run build --workspace @jishi/web",
    "build:windows": "npm run build --workspace @jishi/windows",
    "build:android": "npm run build --workspace @jishi/android",
    "build:harmony": "powershell -ExecutionPolicy Bypass -File clients/harmony/build-hap.ps1",
    "release:manifest": "node scripts/generate-update-manifest.mjs",
    "check:updates": "node scripts/test-update-contract.mjs",
    "check": "npm test --workspace @jishi/server && npm run lint --workspace @jishi/web && npm test --workspace @jishi/web && npm test --workspace @jishi/windows && node --test scripts/backup-crypto.test.mjs scripts/release-layout.test.mjs && npm run check:updates",
    "clean:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/clean-local.ps1",
    "check:release-layout": "node --test scripts/release-layout.test.mjs"
  },
  "overrides": {
    "sharp": "$sharp",
    "js-yaml": "4.3.2",
    "miniflare@5.20261006.0-alpha": {
      "sharp": "$sharp"
    }
  },
  "dependencies": {
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "miniflare": "5.20261006.0-alpha"
  }
}
